# Production Environment Variables Template
# Copy this file to .env.production and fill in the values
# DO NOT commit .env.production to version control

# Firebase Project Configuration
FIREBASE_PROJECT_ID=one-goal1-crore-kc9xh8

# Environment
NODE_ENV=production

# Rate Limiting Configuration
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_HOUR=1000

# OpenAI Configuration
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Subscription Configuration
SUBSCRIBER_MESSAGE_LIMIT=1000
FREE_USER_MESSAGE_LIMIT=10

# Webhook Configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# Secrets (Managed by Google Cloud Secret Manager)
# These are automatically loaded from Secret Manager:
# - OPENAI_API_KEY
# - RAZORPAY_KEY_ID
# - RAZORPAY_SECRET
# - RAPID_API_KEY 